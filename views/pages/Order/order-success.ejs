<%- include('../../partials/header') %>

<main>
    <div class="container">
        <div class="order-confirmation">
            <section>
                <div class="confirmation-header">
                    <div class="success-icon">
                        <div class="checkmark">✓</div>
                    </div>
                    <h2>Order Confirmed!</h2>
                    <p class="order-message">
                        Thank you for your order. Your order number is: 
                        <span class="order-number">#<%= order.OrderID %></span>
                    </p>
                </div>

                <div class="order-details-grid">
                    <div class="order-info-section">
                        <h3>Order Details</h3>
                        <div class="info-table">
                            <div class="info-row">
                                <div class="info-label">Order Date:</div>
                                <div class="info-value"><%= new Date(order.OrderDate).toLocaleString() %></div>
                            </div>
                            <div class="info-row">
                                <div class="info-label">Order Status:</div>
                                <div class="info-value">
                                    <span class="status-badge status-success"><%= order.orderStatus %></span>
                                </div>
                            </div>
                            <div class="info-row">
                                <div class="info-label">Payment Method:</div>
                                <div class="info-value"><%= order.PaymentMethod %></div>
                            </div>
                            <div class="info-row">
                                <div class="info-label">Total Amount:</div>
                                <div class="info-value total-amount">$<%= order.totalAmount.toFixed(2) %></div>
                            </div>
                        </div>
                    </div>

                    <div class="delivery-info-section">
                        <h3>Delivery Information</h3>
                        <div class="info-table">
                            <div class="info-row">
                                <div class="info-label">Shipping Address:</div>
                                <div class="info-value address"><%= order.ShippingAddress %></div>
                            </div>
                            <div class="info-row">
                                <div class="info-label">Contact Phone:</div>
                                <div class="info-value phone"><%= order.ContactNumber %></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="order-items-section">
                    <h3>Order Items</h3>
                    <div class="items-table">
                        <div class="items-header">
                            <div class="col-product">Product</div>
                            <div class="col-quantity">Quantity</div>
                            <div class="col-price">Price</div>
                            <div class="col-total">Total</div>
                        </div>
                        <div class="items-body">
                            <% order.products.forEach(item => { %>
                                <div class="items-row">
                                    <div class="col-product">
                                        <div class="product-info">
                                            <img src="<%= item.product.imageUrl || '/images/placeholder.jpg' %>" alt="<%= item.product.name %>">
                                            <span class="product-name"><%= item.product.name %></span>
                                        </div>
                                    </div>
                                    <div class="col-quantity"><%= item.quantity %></div>
                                    <div class="col-price">$<%= item.product.price.toFixed(2) %></div>
                                    <div class="col-total">$<%= (item.product.price * item.quantity).toFixed(2) %></div>
                                </div>
                            <% }); %>
                        </div>
                    </div>
                </div>

                <div class="confirmation-footer">
                    <a href="/" class="btn continue-shopping-btn">
                        <span>←</span> Continue Shopping
                    </a>
                </div>
            </section>
        </div>
    </div>
</main>

<style>
/* Order Confirmation Styles */
.order-confirmation {
    max-width: 900px;
    margin: 0 auto;
}

.order-confirmation section {
    padding: 2rem;
    margin-bottom: 0;
}

/* Confirmation Header */
.confirmation-header {
    text-align: center;
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 2px solid var(--border-color);
}

.success-icon {
    margin-bottom: 1.5rem;
}

.checkmark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 80px;
    height: 80px;
    background: var(--success);
    color: var(--white);
    border-radius: 50%;
    font-size: 2.5rem;
    font-weight: bold;
    box-shadow: var(--shadow-lg);
    animation: checkmarkPulse 0.6s ease-out;
}

@keyframes checkmarkPulse {
    0% {
        transform: scale(0);
        opacity: 0;
    }
    50% {
        transform: scale(1.1);
    }
    100% {
        transform: scale(1);
        opacity: 1;
    }
}

.confirmation-header h2 {
    color: var(--text-primary);
    font-size: 2.2rem;
    margin-bottom: 1rem;
    font-weight: 600;
}

.order-message {
    color: var(--text-secondary);
    font-size: 1.1rem;
    margin: 0;
}

.order-number {
    color: var(--primary);
    font-weight: 600;
    font-size: 1.2rem;
}

/* Order Details Grid */
.order-details-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin-bottom: 2rem;
}

.order-info-section,
.delivery-info-section {
    background: var(--background);
    padding: 1.5rem;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-color);
}

.order-info-section h3,
.delivery-info-section h3,
.order-items-section h3 {
    color: var(--primary);
    font-size: 1.3rem;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--accent);
}

/* Info Tables */
.info-table {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
}

.info-row {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 1rem;
    align-items: start;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--border-color);
}

.info-row:last-child {
    border-bottom: none;
}

.info-label {
    font-weight: 600;
    color: var(--text-primary);
}

.info-value {
    color: var(--text-secondary);
    word-break: break-word;
}

.info-value.total-amount {
    color: var(--primary);
    font-weight: 600;
    font-size: 1.1rem;
}

.info-value.address {
    line-height: 1.5;
}

.info-value.phone {
    font-weight: 500;
    color: var(--text-primary);
}

/* Status Badge */
.status-badge {
    display: inline-block;
    padding: 0.4rem 0.8rem;
    border-radius: var(--radius-lg);
    font-size: 0.85rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.status-success {
    background: var(--success);
    color: var(--white);
}

/* Order Items Section */
.order-items-section {
    margin-bottom: 2rem;
}

.items-table {
    background: var(--background);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-color);
    overflow: hidden;
}

.items-header,
.items-row {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 1rem;
    align-items: center;
    padding: 1rem;
}

.items-header {
    background: var(--card-bg);
    font-weight: 600;
    color: var(--text-primary);
    border-bottom: 2px solid var(--border-color);
}

.items-row {
    border-bottom: 1px solid var(--border-color);
    transition: var(--transition);
}

.items-row:hover {
    background: var(--hover-bg);
}

.items-row:last-child {
    border-bottom: none;
}

.product-info {
    display: flex;
    align-items: center;
    gap: 0.75rem;
}

.product-info img {
    width: 50px;
    height: 50px;
    object-fit: contain;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-color);
    background: var(--white);
    padding: 0.25rem;
}

.product-name {
    font-weight: 500;
    color: var(--text-primary);
}

.col-quantity,
.col-price,
.col-total {
    text-align: center;
    font-weight: 500;
}

.col-price,
.col-total {
    color: var(--primary);
    font-weight: 600;
}

/* Confirmation Footer */
.confirmation-footer {
    text-align: center;
    padding-top: 2rem;
    border-top: 2px solid var(--border-color);
}

.continue-shopping-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 2rem;
    font-size: 1rem;
    font-weight: 500;
    transition: var(--transition);
}

.continue-shopping-btn:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
}

.continue-shopping-btn span {
    font-size: 1.2rem;
    transition: var(--transition);
}

.continue-shopping-btn:hover span {
    transform: translateX(-2px);
}

/* Responsive Design */
@media (max-width: 992px) {
    .order-details-grid {
        grid-template-columns: 1fr;
        gap: 1.5rem;
    }
}

@media (max-width: 768px) {
    .order-confirmation section {
        padding: 1.5rem;
    }
    
    .confirmation-header h2 {
        font-size: 1.8rem;
    }
    
    .checkmark {
        width: 60px;
        height: 60px;
        font-size: 2rem;
    }
    
    .info-row {
        grid-template-columns: 1fr;
        gap: 0.25rem;
        padding: 0.5rem 0;
    }
    
    .info-label {
        font-size: 0.9rem;
        color: var(--text-muted);
    }
    
    .items-header,
    .items-row {
        grid-template-columns: 1fr;
        gap: 0.5rem;
        text-align: left;
    }
    
    .items-header {
        display: none;
    }
    
    .items-row {
        background: var(--hover-bg);
        border-radius: var(--radius-md);
        margin-bottom: 0.5rem;
        border: 1px solid var(--border-color);
        border-bottom: 1px solid var(--border-color);
    }
    
    .items-row:hover {
        margin-bottom: 0.5rem;
    }
    
    .col-product::before {
        content: "Product: ";
        font-weight: 600;
        color: var(--text-muted);
        font-size: 0.9rem;
    }
    
    .col-quantity::before {
        content: "Quantity: ";
        font-weight: 600;
        color: var(--text-muted);
        font-size: 0.9rem;
    }
    
    .col-price::before {
        content: "Price: ";
        font-weight: 600;
        color: var(--text-muted);
        font-size: 0.9rem;
    }
    
    .col-total::before {
        content: "Total: ";
        font-weight: 600;
        color: var(--text-muted);
        font-size: 0.9rem;
    }
    
    .col-quantity,
    .col-price,
    .col-total {
        text-align: left;
    }
    
    .product-info {
        flex-direction: column;
        align-items: flex-start;
        gap: 0.5rem;
    }
    
    .product-info img {
        width: 40px;
        height: 40px;
    }
}

@media (max-width: 480px) {
    .confirmation-header {
        margin-bottom: 2rem;
        padding-bottom: 1.5rem;
    }
    
    .order-message {
        font-size: 1rem;
    }
    
    .order-number {
        display: block;
        margin-top: 0.5rem;
    }
    
    .continue-shopping-btn {
        padding: 0.75rem 1.5rem;
        font-size: 0.9rem;
    }
}

/* Print Styles */
@media print {
    .navbar,
    .custom-footer,
    .continue-shopping-btn {
        display: none !important;
    }
    
    .order-confirmation {
        max-width: none;
        margin: 0;
    }
    
    .order-confirmation section {
        padding: 1rem;
        box-shadow: none;
        border: 1px solid #000;
    }
    
    .checkmark {
        background: #000 !important;
        color: #fff !important;
    }
}
</style>

<%- include('../../partials/footer') %>