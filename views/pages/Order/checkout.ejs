<%- include('../../partials/header') %>

<main>
    <div class="container">
        <h2>Checkout</h2>
        
        <div class="checkout-container">
            <div class="order-summary">
                <section>
                    <h3>Order Summary</h3>
                    <div class="order-table">
                        <div class="table-header">
                            <div class="col-product">Product</div>
                            <div class="col-quantity">Quantity</div>
                            <div class="col-price">Price</div>
                            <div class="col-total">Total</div>
                        </div>
                        <div class="table-body">
                            <% cart.items.forEach(item => { %>
                                <div class="table-row">
                                    <div class="col-product">
                                        <div class="product-info">
                                            <img src="<%= item.product.imageUrl || '/images/placeholder.jpg' %>" alt="<%= item.product.name %>">
                                            <span><%= item.product.name %></span>
                                        </div>
                                    </div>
                                    <div class="col-quantity"><%= item.quantity %></div>
                                    <div class="col-price">$<%= item.price.toFixed(2) %></div>
                                    <div class="col-total">$<%= item.total.toFixed(2) %></div>
                                </div>
                            <% }); %>
                        </div>
                        <div class="table-footer">
                            <div class="total-row">
                                <div class="total-label">Subtotal:</div>
                                <div class="total-value">$<%= cart.totalAmount.toFixed(2) %></div>
                            </div>
                            <div class="total-row">
                                <div class="total-label">Delivery Fee:</div>
                                <div class="total-value">$<%= (cart.deliveryFee || 50).toFixed(2) %></div>
                            </div>
                            <div class="total-row grand-total">
                                <div class="total-label">Total:</div>
                                <div class="total-value">$<%= (cart.grandTotal || (cart.totalAmount + (cart.deliveryFee || 50))).toFixed(2) %></div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
            
            <div class="delivery-info">
                <section>
                    <h3>Delivery Information</h3>
                    <form action="/order/place" method="post" id="checkoutForm" class="checkout-form">
                        
                        <!-- Address Section -->
                        <div class="form-section">
                            <h4>Shipping Address</h4>
                            <div class="choice-group">
                                <div class="choice-option">
                                    <input type="radio" id="useAccountAddress" name="addressChoice" value="account" checked>
                                    <label for="useAccountAddress">Use my account address</label>
                                </div>
                                <div class="choice-option">
                                    <input type="radio" id="useNewAddress" name="addressChoice" value="new">
                                    <label for="useNewAddress">Enter new address</label>
                                </div>
                            </div>
                            
                            <div class="form-group" id="newAddressGroup" style="display: none;">
                                <label for="shippingAddress" class="form-label">New Shipping Address</label>
                                <textarea class="form-control" 
                                          id="shippingAddress" 
                                          name="shippingAddress" 
                                          minlength="10" 
                                          maxlength="200"
                                          placeholder="Enter your complete shipping address..."></textarea>
                                <div class="error-message" id="addressError">
                                    Please enter a valid shipping address (10-200 characters).
                                </div>
                            </div>
                            
                            <div class="account-info" id="accountAddressInfo">
                                <div class="info-display">
                                    <strong>Account Address:</strong>
                                    <span id="userAddress"><%= user && user.address ? user.address : 'No address saved' %></span>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Phone Section -->
                        <div class="form-section">
                            <h4>Contact Phone</h4>
                            <div class="choice-group">
                                <div class="choice-option">
                                    <input type="radio" id="useAccountPhone" name="phoneChoice" value="account" checked>
                                    <label for="useAccountPhone">Use my account phone</label>
                                </div>
                                <div class="choice-option">
                                    <input type="radio" id="useNewPhone" name="phoneChoice" value="new">
                                    <label for="useNewPhone">Enter new phone number</label>
                                </div>
                            </div>
                            
                            <div class="form-group" id="newPhoneGroup" style="display: none;">
                                <label for="contactPhone" class="form-label">New Contact Phone</label>
                                <input type="tel" 
                                       class="form-control" 
                                       id="contactPhone" 
                                       name="contactPhone" 
                                       placeholder="Enter 11-digit phone number"
                                       maxlength="11">
                                <div class="error-message" id="phoneError">
                                    Phone number must be exactly 11 digits.
                                </div>
                            </div>
                            
                            <div class="account-info" id="accountPhoneInfo">
                                <div class="info-display">
                                    <strong>Account Phone:</strong>
                                    <span id="userPhone"><%= user && user.phoneNumber ? user.phoneNumber : 'No phone saved' %></span>
                                </div>
                            </div>
                        </div>
                        
                        <div class="payment-info">
                            <i class="info-icon">ℹ</i>
                            <span>Payment Method: Cash on Delivery</span>
                        </div>
                        
                        <button type="submit" class="btn checkout-btn" id="submitBtn">
                            Place Order
                        </button>
                    </form>
                </section>
            </div>
        </div>
    </div>
</main>

<style>
/* Checkout specific styles */
.checkout-container {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 2rem;
    margin-top: 2rem;
}

.order-summary section,
.delivery-info section {
    margin-bottom: 0;
}

.order-summary h3,
.delivery-info h3 {
    color: var(--primary);
    font-size: 1.3rem;
    margin-bottom: 1.5rem;
    border-bottom: 2px solid var(--accent);
    padding-bottom: 0.5rem;
}

/* Order table styles */
.order-table {
    width: 100%;
}

.table-header,
.table-row {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 1rem;
    align-items: center;
    padding: 1rem 0;
}

.table-header {
    font-weight: 600;
    color: var(--text-primary);
    border-bottom: 2px solid var(--border-color);
    background: var(--background);
    border-radius: var(--radius-md) var(--radius-md) 0 0;
    padding: 1rem;
    margin: 0 -1rem;
}

.table-row {
    border-bottom: 1px solid var(--border-color);
    transition: var(--transition);
}

.table-row:hover {
    background: var(--hover-bg);
    border-radius: var(--radius-md);
    margin: 0 -1rem;
    padding: 1rem;
}

.table-row:last-child {
    border-bottom: none;
}

.product-info {
    display: flex;
    align-items: center;
    gap: 0.75rem;
}

.product-info img {
    width: 50px;
    height: 50px;
    object-fit: contain;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-color);
    background: var(--background);
    padding: 0.25rem;
}

.col-quantity,
.col-price,
.col-total {
    text-align: center;
    font-weight: 500;
}

.col-price,
.col-total {
    color: var(--primary);
    font-weight: 600;
}

/* Table footer */
.table-footer {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 2px solid var(--border-color);
}

.total-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.5rem 0;
    font-weight: 500;
}

.total-row.grand-total {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--primary);
    border-top: 1px solid var(--border-color);
    margin-top: 0.5rem;
    padding-top: 1rem;
}

.total-label {
    color: var(--text-primary);
}

.total-value {
    color: var(--primary);
    font-weight: 600;
}

/* Form styles */
.checkout-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
}

.form-section {
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    background: var(--card-bg);
}

.form-section h4 {
    color: var(--primary);
    font-size: 1.1rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.5rem;
}

.choice-group {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1rem;
}

.choice-option {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem;
    border-radius: var(--radius-sm);
    transition: var(--transition);
}

.choice-option:hover {
    background: var(--hover-bg);
}

.choice-option input[type="radio"] {
    margin: 0;
    cursor: pointer;
}

.choice-option label {
    cursor: pointer;
    font-weight: 500;
    color: var(--text-primary);
    margin: 0;
}

.account-info {
    background: var(--accent);
    border: 1px solid var(--sage);
    border-radius: var(--radius-md);
    padding: 1rem;
    margin-top: 1rem;
}

.info-display {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
}

.info-display strong {
    color: var(--text-primary);
    font-size: 0.9rem;
}

.info-display span {
    color: var(--text-primary);
    font-size: 1rem;
    word-break: break-word;
}

.form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
}

.form-label {
    font-weight: 500;
    color: var(--text-primary);
    margin-bottom: 0.25rem;
}

.form-control {
    padding: 0.75rem;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    background: var(--background);
    color: var(--text-primary);
    font-size: 0.9rem;
    transition: var(--transition);
}

.form-control:focus {
    border-color: var(--primary);
    box-shadow: 0 0 0 2px rgba(74, 124, 122, 0.1);
    background: var(--card-bg);
    outline: none;
    color: var(--text-primary);
}

.form-control.error {
    border-color: var(--danger);
    box-shadow: 0 0 0 2px rgba(220, 53, 69, 0.1);
}

textarea.form-control {
    resize: vertical;
    min-height: 100px;
    font-family: inherit;
    color: var(--text-primary);
    background: var(--background);
}

textarea.form-control:focus {
    color: var(--text-primary);
    background: var(--card-bg);
}

.error-message {
    color: var(--danger);
    font-size: 0.85rem;
    display: none;
    margin-top: 0.25rem;
}

.error-message.show {
    display: block;
}

/* Payment info */
.payment-info {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 1rem;
    background: var(--accent);
    color: var(--text-primary);
    border-radius: var(--radius-md);
    font-weight: 500;
    border: 1px solid var(--sage);
}

.info-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    background: var(--primary);
    color: var(--white);
    border-radius: 50%;
    font-size: 0.8rem;
    font-weight: bold;
}

/* Checkout button */
.checkout-btn {
    width: 100%;
    padding: 1rem;
    font-size: 1rem;
    font-weight: 600;
    margin-top: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
}

.checkout-btn:disabled {
    opacity: 0.7;
    cursor: not-allowed;
}

/* Loading spinner */
.spinner {
    width: 16px;
    height: 16px;
    border: 2px solid var(--white);
    border-top: 2px solid transparent;
    border-radius: 50%;
    animation: spin 1s linear infinite;
}

/* Responsive design */
@media (max-width: 992px) {
    .checkout-container {
        grid-template-columns: 1fr;
        gap: 1.5rem;
    }
    
    .order-summary {
        order: 1;
    }
    
    .delivery-info {
        order: 2;
    }
}

@media (max-width: 768px) {
    .table-header,
    .table-row {
        grid-template-columns: 1fr;
        gap: 0.5rem;
        text-align: left;
    }
    
    .table-header {
        display: none;
    }
    
    .table-row {
        background: var(--hover-bg);
        border-radius: var(--radius-md);
        padding: 1rem;
        margin-bottom: 0.5rem;
        border: 1px solid var(--border-color);
        border-bottom: 1px solid var(--border-color);
    }
    
    .table-row:hover {
        margin-bottom: 0.5rem;
    }
    
    .col-product::before {
        content: "Product: ";
        font-weight: 600;
        color: var(--text-muted);
    }
    
    .col-quantity::before {
        content: "Quantity: ";
        font-weight: 600;
        color: var(--text-muted);
    }
    
    .col-price::before {
        content: "Price: ";
        font-weight: 600;
        color: var(--text-muted);
    }
    
    .col-total::before {
        content: "Total: ";
        font-weight: 600;
        color: var(--text-muted);
    }
    
    .col-quantity,
    .col-price,
    .col-total {
        text-align: left;
    }
}

@media (max-width: 480px) {
    .checkout-container {
        gap: 1rem;
    }
    
    main {
        padding: 1rem 0.5rem;
    }
    
    .product-info {
        flex-direction: column;
        align-items: flex-start;
        gap: 0.5rem;
    }
    
    .product-info img {
        width: 40px;
        height: 40px;
    }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('checkoutForm');
    if (!form) return;

    // Radio button elements
    const addressChoiceRadios = document.querySelectorAll('input[name="addressChoice"]');
    const phoneChoiceRadios = document.querySelectorAll('input[name="phoneChoice"]');
    
    // Form groups
    const newAddressGroup = document.getElementById('newAddressGroup');
    const newPhoneGroup = document.getElementById('newPhoneGroup');
    const accountAddressInfo = document.getElementById('accountAddressInfo');
    const accountPhoneInfo = document.getElementById('accountPhoneInfo');
    
    // Input elements
    const addressInput = document.getElementById('shippingAddress');
    const phoneInput = document.getElementById('contactPhone');
    const submitBtn = document.getElementById('submitBtn');
    
    // Error elements
    const addressError = document.getElementById('addressError');
    const phoneError = document.getElementById('phoneError');
    
    // Handle address choice
    addressChoiceRadios.forEach(radio => {
        radio.addEventListener('change', function() {
            if (this.value === 'new') {
                newAddressGroup.style.display = 'block';
                accountAddressInfo.style.display = 'none';
                addressInput.setAttribute('required', 'required');
            } else {
                newAddressGroup.style.display = 'none';
                accountAddressInfo.style.display = 'block';
                addressInput.removeAttribute('required');
                addressInput.classList.remove('error');
                addressError.classList.remove('show');
            }
        });
    });
    
    // Handle phone choice
    phoneChoiceRadios.forEach(radio => {
        radio.addEventListener('change', function() {
            if (this.value === 'new') {
                newPhoneGroup.style.display = 'block';
                accountPhoneInfo.style.display = 'none';
                phoneInput.setAttribute('required', 'required');
            } else {
                newPhoneGroup.style.display = 'none';
                accountPhoneInfo.style.display = 'block';
                phoneInput.removeAttribute('required');
                phoneInput.classList.remove('error');
                phoneError.classList.remove('show');
            }
        });
    });
    
    function validateAddress() {
        const addressChoice = document.querySelector('input[name="addressChoice"]:checked').value;
        
        if (addressChoice === 'new') {
            const value = addressInput.value.trim();
            if (value.length >= 10 && value.length <= 200) {
                addressInput.classList.remove('error');
                addressError.classList.remove('show');
                return true;
            } else {
                addressInput.classList.add('error');
                addressError.classList.add('show');
                return false;
            }
        } else {
            // Using account address - check if user has address
            const userAddress = document.getElementById('userAddress').textContent;
            if (userAddress === 'No address saved') {
                UIManager.showMessage('Please add an address to your account or enter a new address', 'warning');
                return false;
            }
            return true;
        }
    }
    
    function validatePhone() {
        const phoneChoice = document.querySelector('input[name="phoneChoice"]:checked').value;
        
        if (phoneChoice === 'new') {
            const phonePattern = /^[0-9]{11}$/;
            if (phonePattern.test(phoneInput.value.replace(/\D/g, ''))) {
                phoneInput.classList.remove('error');
                phoneError.classList.remove('show');
                return true;
            } else {
                phoneInput.classList.add('error');
                phoneError.classList.add('show');
                return false;
            }
        } else {
            // Using account phone - check if user has phone
            const userPhone = document.getElementById('userPhone').textContent;
            if (userPhone === 'No phone saved') {
                UIManager.showMessage('Please add a phone number to your account or enter a new phone number', 'warning');
                return false;
            }
            return true;
        }
    }
    
    form.addEventListener('submit', function(e) {
        const isAddressValid = validateAddress();
        const isPhoneValid = validatePhone();
        
        if (!isAddressValid || !isPhoneValid) {
            e.preventDefault(); // Stop form submission
            
            const firstError = document.querySelector('.form-control.error');
            if (firstError) {
                firstError.scrollIntoView({ behavior: 'smooth', block: 'center' });
                firstError.focus();
            }
        } else {
            // Show loading state
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="spinner"></span> Processing...';
        }
    });

    // Real-time validation
    addressInput.addEventListener('input', validateAddress);
    phoneInput.addEventListener('input', validatePhone);
});

// Format phone number input to allow only 11 digits
document.getElementById('contactPhone').addEventListener('input', function (e) {
    let value = e.target.value.replace(/\D/g, '');
    if (value.length > 11) {
        value = value.slice(0, 11);
    }
    e.target.value = value;
});

// Simple message display function (if UIManager is not available)
function showMessage(message, type = 'info') {
    const alertDiv = document.createElement('div');
    alertDiv.className = `alert alert-${type} alert-dismissible fade show`;
    alertDiv.innerHTML = `
        ${message}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    `;
    
    document.body.insertBefore(alertDiv, document.body.firstChild);
    
    setTimeout(() => {
        if (alertDiv.parentNode) {
            alertDiv.remove();
        }
    }, 5000);
}

// Make showMessage globally available
window.showMessage = showMessage;
</script>

<%- include('../../partials/footer') %>