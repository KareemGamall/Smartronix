<%- include('../../partials/header') %>

<style>
    /* Modern Minimalist User Profile */
    .userprofile {
        padding: 2rem 0;
        min-height: 80vh;
        background: linear-gradient(135deg, var(--background) 0%, var(--card-bg) 100%);
    }

    [data-theme="dark"] .userprofile {
        background: linear-gradient(135deg, var(--background) 0%, var(--card-bg) 100%);
    }

    .userprofile .container {
        max-width: 720px;
    }

    .userprofile .profile-card {
        background: var(--card-bg);
        backdrop-filter: blur(20px);
        border: 1px solid var(--border-color);
        border-radius: 24px;
        box-shadow: var(--shadow-md);
        overflow: hidden;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    [data-theme="dark"] .userprofile .profile-card {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        box-shadow: var(--shadow-md);
    }

    .userprofile .profile-card:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow-lg);
    }

    [data-theme="dark"] .userprofile .profile-card:hover {
        box-shadow: var(--shadow-lg);
    }

    .userprofile .profile-header {
        padding: 2rem 2rem 1rem 2rem;
        text-align: center;
        position: relative;
    }

    .userprofile .profile-header::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 60px;
        height: 2px;
        background: linear-gradient(90deg, var(--primary), var(--teal));
        border-radius: 2px;
    }

    .userprofile .profile-title {
        font-size: 1.75rem;
        font-weight: 700;
        color: var(--text-primary);
        margin: 0;
        letter-spacing: -0.025em;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
    }

    [data-theme="dark"] .userprofile .profile-title {
        color: var(--text-primary);
    }

    .userprofile .profile-icon {
        width: 2.5rem;
        height: 2.5rem;
        background: linear-gradient(135deg, var(--primary), var(--teal));
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1.25rem;
    }

    .userprofile .profile-body {
        padding: 1.5rem 2rem 2rem 2rem;
    }

    .userprofile .form-group {
        margin-bottom: 1.75rem;
        opacity: 0;
        animation: slideUp 0.6s ease-out forwards;
    }

    .userprofile .form-group:nth-child(1) { animation-delay: 0.1s; }
    .userprofile .form-group:nth-child(2) { animation-delay: 0.15s; }
    .userprofile .form-group:nth-child(3) { animation-delay: 0.2s; }
    .userprofile .form-group:nth-child(4) { animation-delay: 0.25s; }

    .userprofile .form-label {
        display: block;
        font-weight: 600;
        font-size: 0.875rem;
        color: var(--text-primary);
        margin-bottom: 0.5rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    [data-theme="dark"] .userprofile .form-label {
        color: var(--text-primary);
    }

    .userprofile .form-label-icon {
        width: 1rem;
        height: 1rem;
        color: var(--primary);
    }

    .userprofile .form-control {
        width: 100%;
        padding: 0.875rem 1rem;
        border: 1.5px solid var(--border-color);
        border-radius: 12px;
        background: var(--background);
        color: var(--text-primary);
        font-size: 0.95rem;
        font-weight: 500;
        transition: all 0.2s ease;
        outline: none;
    }

    [data-theme="dark"] .userprofile .form-control {
        border-color: var(--border-color);
        background: var(--background);
        color: var(--text-primary);
    }

    .userprofile .form-control:hover {
        border-color: var(--primary);
    }

    [data-theme="dark"] .userprofile .form-control:hover {
        border-color: var(--primary);
    }

    .userprofile .form-control:focus {
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(74, 124, 122, 0.1);
        background: var(--card-bg);
    }

    [data-theme="dark"] .userprofile .form-control:focus {
        background: var(--card-bg);
        box-shadow: 0 0 0 3px rgba(74, 124, 122, 0.2);
    }

    .userprofile .form-control:read-only {
        background: var(--hover-bg);
        border-color: var(--border-color);
        cursor: not-allowed;
        opacity: 0.7;
    }

    [data-theme="dark"] .userprofile .form-control:read-only {
        background: var(--hover-bg);
        border-color: var(--border-color);
    }

    .userprofile .form-control::placeholder {
        color: var(--text-muted);
        font-weight: 400;
    }

    .userprofile .form-text {
        font-size: 0.8rem;
        color: var(--text-muted);
        margin-top: 0.375rem;
        display: block;
    }

    [data-theme="dark"] .userprofile .form-text {
        color: var(--text-muted);
    }

    .userprofile .textarea-control {
        resize: vertical;
        min-height: 80px;
        max-height: 160px;
    }

    .userprofile .form-actions {
        display: flex;
        justify-content: flex-end;
        margin-top: 2rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--border-color);
    }

    [data-theme="dark"] .userprofile .form-actions {
        border-top-color: var(--border-color);
    }

    .userprofile .btn-primary {
        background: linear-gradient(135deg, var(--primary), var(--teal));
        border: none;
        color: white;
        padding: 0.75rem 2rem;
        border-radius: 12px;
        font-weight: 600;
        font-size: 0.9rem;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        transition: all 0.2s ease;
        box-shadow: 0 4px 12px rgba(74, 124, 122, 0.3);
        text-transform: none;
        letter-spacing: 0;
    }

    .userprofile .btn-primary:hover {
        transform: translateY(-1px);
        box-shadow: 0 6px 16px rgba(74, 124, 122, 0.4);
        background: linear-gradient(135deg, var(--teal), var(--primary));
    }

    .userprofile .btn-primary:active {
        transform: translateY(0);
    }

    .userprofile .btn-primary:disabled {
        background: var(--gray-medium);
        cursor: not-allowed;
        transform: none;
        box-shadow: none;
    }

    .userprofile .spinner {
        width: 1rem;
        height: 1rem;
        border: 2px solid rgba(255, 255, 255, 0.3);
        border-top-color: white;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
    }

    /* Grid System */
    .userprofile .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
        margin-bottom: 0.25rem;
    }

    /* Responsive Design */
    @media (max-width: 768px) {
        .userprofile {
            padding: 1rem 0;
        }

        .userprofile .form-row {
            grid-template-columns: 1fr;
            gap: 1.75rem;
        }

        .userprofile .profile-header {
            padding: 1.5rem 1.5rem 1rem 1.5rem;
        }

        .userprofile .profile-body {
            padding: 1rem 1.5rem 1.5rem 1.5rem;
        }

        .userprofile .profile-title {
            font-size: 1.5rem;
            flex-direction: column;
            gap: 0.5rem;
        }

        .userprofile .profile-icon {
            width: 3rem;
            height: 3rem;
            font-size: 1.5rem;
        }

        .userprofile .form-actions {
            justify-content: stretch;
        }

        .userprofile .btn-primary {
            width: 100%;
            justify-content: center;
            padding: 1rem 2rem;
        }
    }

    /* Animations */
    @keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @keyframes spin {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }

    /* Alert Container */
    #alertContainer {
        margin-bottom: 1.5rem;
    }

    /* Form Validation States */
    .userprofile .form-control.is-valid {
        border-color: var(--success);
        box-shadow: 0 0 0 3px rgba(40, 167, 69, 0.1);
    }

    .userprofile .form-control.is-invalid {
        border-color: var(--danger);
        box-shadow: 0 0 0 3px rgba(220, 53, 69, 0.1);
    }
</style>

<!-- Main Content -->
<div class="container userprofile">
    <div class="row">
        <div class="col-12">
            <div class="profile-card">
                <div class="profile-header">
                    <h1 class="profile-title">
                        <div class="profile-icon">
                            <i class="fas fa-user"></i>
                        </div>
                        Profile Settings
                    </h1>
                </div>
                <div class="profile-body">
                    <div id="alertContainer"></div>

                    <form id="profileForm">
                        <div class="form-row">
                            <div class="form-group">
                                <label for="name" class="form-label">
                                    <i class="fas fa-user form-label-icon"></i>
                                    Full Name
                                </label>
                                <input type="text" class="form-control" id="name" name="name"
                                       value="<%= user.name %>" required>
                            </div>
                            <div class="form-group">
                                <label for="email" class="form-label">
                                    <i class="fas fa-envelope form-label-icon"></i>
                                    Email Address
                                </label>
                                <input type="email" class="form-control" id="email" name="email"
                                       value="<%= user.email %>" readonly>
                                <small class="form-text">Email cannot be changed</small>
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label for="phoneNumber" class="form-label">
                                    <i class="fas fa-phone form-label-icon"></i>
                                    Phone Number
                                </label>
                                <input type="tel" class="form-control" id="phoneNumber" name="phoneNumber"
                                       value="<%= user.phoneNumber || '' %>"
                                       placeholder="Enter 11-digit phone number"
                                       maxlength="11">
                                <small class="form-text">Must be exactly 11 digits</small>
                            </div>
                            <div class="form-group">
                                <label for="address" class="form-label">
                                    <i class="fas fa-map-marker-alt form-label-icon"></i>
                                    Address
                                </label>
                                <textarea class="form-control textarea-control" id="address" name="address"
                                          placeholder="Enter your complete address"><%= user.address || '' %></textarea>
                            </div>
                        </div>

                        <div class="form-actions">
                            <button type="submit" class="btn-primary" id="updateBtn">
                                <i class="fas fa-save"></i>
                                Update Profile
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<main>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const profileForm = document.getElementById('profileForm');
            const alertContainer = document.getElementById('alertContainer');
            const updateBtn = document.getElementById('updateBtn');

            function showAlert(message, type = 'info') {
                // Use the main UIManager.showMessage for consistent styling
                if (window.UIManager && window.UIManager.showMessage) {
                    window.UIManager.showMessage(message, type);
                } else {
                    // Fallback to simple alert if UIManager not available
                    const alertDiv = document.createElement('div');
                    alertDiv.className = `alert alert-${type}`;
                    alertDiv.innerHTML = `
                        <span>${message}</span>
                        <button type="button" class="btn-close" aria-label="Close"></button>
                    `;
                    
                    // Add close functionality
                    const closeBtn = alertDiv.querySelector('.btn-close');
                    closeBtn.addEventListener('click', () => {
                        alertDiv.remove();
                    });
                    
                    alertContainer.innerHTML = '';
                    alertContainer.appendChild(alertDiv);

                    setTimeout(() => {
                        if (alertDiv.parentNode) alertDiv.remove();
                    }, 5000);
                }
            }
            
            // Wait for UIManager to be available
            function waitForUIManager() {
                if (window.UIManager && window.UIManager.showMessage) {
                    return;
                }
                setTimeout(waitForUIManager, 100);
            }
            
            // Start waiting for UIManager
            waitForUIManager();

            profileForm.addEventListener('submit', async function (e) {
                e.preventDefault();

                updateBtn.disabled = true;
                updateBtn.innerHTML = '<div class="spinner"></div>Updating...';

                const formData = {
                    name: document.getElementById('name').value.trim(),
                    phoneNumber: document.getElementById('phoneNumber').value.trim(),
                    address: document.getElementById('address').value.trim()
                };

                try {
                    const response = await fetch('/api/user/update-profile', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        body: JSON.stringify(formData)
                    });

                    const data = await response.json();

                    if (response.ok) {
                        showAlert('Profile updated successfully!', 'success');
                    } else {
                        showAlert(data.error || 'Failed to update profile', 'danger');
                    }
                } catch (error) {
                    console.error('Error updating profile:', error);
                    showAlert('An error occurred while updating your profile', 'danger');
                } finally {
                    updateBtn.disabled = false;
                    updateBtn.innerHTML = '<i class="fas fa-save"></i>Update Profile';
                }
            });
        });
    </script>
</main>

<%- include('../../partials/footer') %>