<%- include('../../partials/header') %>

<main>
    <section class="hero-section">
        <div class="container">
            <div class="hero-content">
                <div class="hero-text ms-2">
                    <h1 class="hero-title">TECHNOLOGY HACK YOU WON'T GET</h1>
                    <p class="hero-subtitle">Discover the latest in cutting-edge electronics and smart devices</p>
                    <div class="hero-buttons">
                        <a href="/products" class="btn btn-primary hero-btn">Shop Now</a>
                        <a href="#categories" class="btn btn-outline-primary hero-btn">Explore Categories</a>
                    </div>
                </div>
                <div class="hero-image">
                    <img src="https://res.cloudinary.com/dtvxoju3p/image/upload/v1755735358/BANNAR_eacrhj.png" 
                         alt="Smartronix Mobile Phone"
                         class="hero-phone">
                </div>
            </div>
        </div>
    </section>

    <section class="categories" id="categories">
        <h2>Categories</h2>
        <div class="categories-grid">
            <% if (mainCategories && mainCategories.length > 0) { %>
    <% mainCategories.forEach(category => { %>
        <a href="/products/category/<%= category.categoryID %>" class="category-link">
            <div class="category-card <%= category.iconClass %>">
                <div class="category-card-header">
                    <div class="category-card-content">
                        <h3 class="category-card-title"><%= category.name %></h3>
                        <p class="category-card-subtitle"><%= category.description %></p>
                        <div class="card-arrow">
                            <i class="fas fa-arrow-right"></i>
                        </div>
                    </div>
                    <div class="card-icon">
                        <i class="fas fa-<%= category.iconClass %>"></i>
                    </div>
                </div>
                <div class="decorative-shape"></div>
            </div>
        </a>
    <% }); %>
<% } else { %>
    <p>No categories available.</p>
<% } %>
        </div>
    </section>

    <section class="new-arrivals">
        <h2>New Arrivals</h2>
        <div class="container">
            <div class="row">
                <% if (newArrivals && newArrivals.length > 0) { %>
                    <% newArrivals.forEach(product => { %>
                        <div class="col-lg-4 col-md-6 mb-4">
                            <div class="product-card">
                                <div class="product-image">
                                    <a href="/products/details/<%= product._id %>" class="text-decoration-none">
                                        <img src="<%= product.imageUrl %>" 
                                             alt="<%= product.name %>" 
                                             class="product-img">
                                    </a>
                                </div>
                                
                                <div class="product-details">
                                    <h3 class="product-title"><%= product.name %></h3>
                                    
                                    <div class="product-tags">
                                        <span class="category-name"><%= product.category ? product.category.name : 'Uncategorized' %></span>
                                    </div>
                                    
                                    <p class="product-description">
                                        <%= product.description.substring(0, 100) %>...
                                    </p>
                                    
                                    <div class="product-footer">
                                        <div class="price-section">
                                            <div class="price-label">Price</div>
                                            <div class="price">$<%= product.price %></div>
                                        </div>
                                        <button class="add-to-cart" data-product-id="<%= product._id %>">
                                            Add to cart
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                <% } else { %>
                    <div class="col-12">
                        <div class="alert alert-info" role="alert">
                            No new arrivals available.
                        </div>
                    </div>
                <% } %>
            </div>
        </div>
    </section>

    <section class="best-sellers">
        <h2>Best Sellers</h2>
        <div class="container">
            <div class="row">
                <% if (bestSellers && bestSellers.length > 0) { %>
                    <% bestSellers.forEach(product => { %>
                        <div class="col-lg-4 col-md-6 mb-4">
                            <div class="product-card">
                                <div class="product-image">
                                    <a href="/products/details/<%= product._id %>" class="text-decoration-none">
                                        <img src="<%= product.imageUrl %>" 
                                             alt="<%= product.name %>" 
                                             class="product-img">
                                    </a>
                                </div>
                                
                                <div class="product-details">
                                    <h3 class="product-title"><%= product.name %></h3>
                                    
                                    <div class="product-tags">
                                        <span class="category-name"><%= product.category ? product.category.name : 'Uncategorized' %></span>
                                        <span class="category-name" style="background: var(--success); color: var(--white);">
                                            <i class="fas fa-star"></i> Popular
                                        </span>
                                    </div>
                                    
                                    <p class="product-description">
                                        <%= product.description.substring(0, 100) %>...
                                    </p>
                                    
                                    <div class="product-footer">
                                        <div class="price-section">
                                            <div class="price-label">Price</div>
                                            <div class="price">$<%= product.price %></div>
                                        </div>
                                        <button class="add-to-cart" data-product-id="<%= product._id %>">
                                            Add to cart
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                <% } else { %>
                    <div class="col-12">
                        <div class="alert alert-info" role="alert">
                            No best sellers available.
                        </div>
                    </div>
                <% } %>
            </div>
        </div>
    </section>
</main>

<%- include('../../partials/footer') %> 