<%- include('../../partials/header') %>

<div class="container mt-4">
    <h1 class="mb-4"><%= title || 'Products' %></h1>
    
    <% if (typeof message !== 'undefined' && message) { %>
        <div class="alert alert-info" role="alert">
            <%= message %>
        </div>
    <% } %>
    
    <div class="row">
        <% if (products && products.length > 0) { %>
            <% products.forEach(product => { %>
                <div class="col-lg-4 col-md-6 mb-4">
                    <div class="product-card">
                        <div class="product-image">
                            <a href="/products/details/<%= product._id %>" class="text-decoration-none">
                                <img src="<%= product.imageUrl %>" 
                                     alt="<%= product.name %>" 
                                     class="product-img">
                            </a>
                        </div>
                        
                        <div class="product-details">
                            <h3 class="product-title"><%= product.name %></h3>
                            
                            <div class="product-tags">
                                <span class="category-name"><%= product.category ? product.category.name : 'Uncategorized' %></span>
                            </div>
                            
                            <p class="product-description">
                                <%= product.description.substring(0, 100) %>...
                            </p>
                            
                            <div class="product-footer">
                                <div class="price-section">
                                    <div class="price-label">Price</div>
                                    <div class="price">$<%= product.price %></div>
                                </div>
                                <button class="add-to-cart" data-product-id="<%= product._id %>">
                                    Add to cart
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            <% }) %>
        <% } else { %>
            <div class="col-12">
                <div class="alert alert-info" role="alert">
                    No products found. Please check back later.
                </div>
            </div>
        <% } %>
    </div>
</div>

<%- include('../../partials/footer') %>