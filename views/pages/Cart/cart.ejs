<%- include('../../partials/header') %>

<div class="cartpage">
    <% if (!cart || !cart.items || cart.items.length === 0) { %>
        <div class="empty-cart mt-4">
            <i class="fa-solid fa-shopping-cart"></i>
            <h2>Your cart is empty</h2>
            <p>Looks like you haven't added anything yet. Start exploring our amazing products!</p>
            <a href="/products" class="continue-shopping">
                Continue Shopping
            </a>
        </div>
    <% } else { %>
        <div class="cartitems mt-4">
            <% cart.items.forEach(item => { %>
                <% if (item.product) { %>
                    <div class="cartitem">
                        <div class="productincart">
                            <img src="<%= item.product.imageUrl %>" alt="<%= item.product.name %>" />
                            <div class="itemdetails">
                                <p><%= item.product.name %></p>
                                <span class="itemsize">Price: $<%= item.price.toFixed(2) %></span>
                            </div>
                        </div>
                        <span class="itemprice">$<%= item.price.toFixed(2) %></span>
                        <div class="quantity">
                            <div class="quantity-controls">
                                <button type="button" class="btn btn-outline-secondary quantity-btn" data-action="decrease" data-product-id="<%= item.product._id %>">
                                    <i class="fas fa-minus"></i>
                                </button>
                                <input type="number" 
                                       class="qty" 
                                       value="<%= item.quantity %>" 
                                       data-price="<%= item.price %>" 
                                       data-product-id="<%= item.product._id %>"
                                       data-stock="<%= item.product.stockQuantity %>"
                                       min="1" 
                                       max="<%= item.product.stockQuantity %>" />
                                <button type="button" class="btn btn-outline-secondary quantity-btn" data-action="increase" data-product-id="<%= item.product._id %>">
                                    <i class="fas fa-plus"></i>
                                </button>
                            </div>
                        </div>
                        <span class="totalprice">$<%= item.total.toFixed(2) %></span>
                        <button class="remove" 
                                onclick="removeFromCart('<%= item.product._id %>')">
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                    </div>
                <% } else { %>
                    <div class="cartitem">
                        <div class="productincart">
                            <img src="/img/placeholder-product.png" alt="Product Unavailable" />
                            <div class="itemdetails">
                                <p>Product Unavailable</p>
                                <span class="itemsize">Price: $<%= item.price.toFixed(2) %></span>
                            </div>
                        </div>
                        <span class="itemprice">$<%= item.price.toFixed(2) %></span>
                        <div class="quantity">
                            <input type="number" 
                                   class="qty" 
                                   value="<%= item.quantity %>" 
                                   data-price="<%= item.price %>" 
                                   data-product-id="unknown"
                                   data-stock="0"
                                   min="1" 
                                   max="1" 
                                   disabled />
                        </div>
                        <span class="totalprice">$<%= item.total.toFixed(2) %></span>
                        <button class="remove" 
                                onclick="removeFromCart('unknown')">
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                    </div>
                <% } %>
            <% }); %>
        </div>

        <div class="cart-total">
            <h3>Cart Total</h3>
            <p>Subtotal <span class="subtotal">$<%= cart.totalAmount.toFixed(2) %></span></p>
            <p>Delivery Fee <span>(Standard) $50.00</span></p>
            <p>Grand Total <span class="grandtotal">$<%= (cart.totalAmount + 50).toFixed(2) %></span></p>
            <form action="/order/checkout" method="get" id="checkoutForm">
                <button type="submit" class="checkout-btn" id="checkoutBtn">Proceed to Checkout</button>
            </form>
        </div>
    <% } %>
</div>

<%- include('../../partials/footer') %>
