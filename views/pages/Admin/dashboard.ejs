<!-- Page Heading -->
<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Dashboard</h1>
</div>

<!-- Alert Container -->
<div id="alert-container"></div>

<!-- Content Row -->
<div class="row" id="dashboard-stats">
    <!-- Monthly Revenue Card -->
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card stats-card info h-100 py-2 border-left-info">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-info text-uppercase mb-1">
                            Monthly Revenue</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800" id="monthly-revenue">
                            $<%= stats?.monthlyRevenue?.toFixed(2) || '0.00' %>
                        </div>
                        <div class="text-xs text-success">
                            <i class="fas fa-arrow-up"></i> 12% from last month
                        </div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-chart-line fa-2x text-info"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Annual Revenue Card -->
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card stats-card warning h-100 py-2 border-left-warning">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                            Annual Revenue</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800" id="annual-revenue">
                            $<%= stats?.annualRevenue?.toFixed(2) || '0.00' %>
                        </div>
                        <div class="text-xs text-success">
                            <i class="fas fa-arrow-up"></i> 8% from last year
                        </div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-chart-bar fa-2x text-warning"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Total Users Card -->
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card stats-card primary h-100 py-2 border-left-primary">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                            Total Users</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800" id="total-users">
                            <%= stats?.totalUsers || 0 %>
                        </div>
                        <div class="text-xs text-success">
                            <i class="fas fa-arrow-up"></i> 5 new this week
                        </div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-user-plus fa-2x text-primary"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Total Products Card -->
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card stats-card success h-100 py-2 border-left-success">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                            Total Products</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800" id="total-products">
                            <%= stats?.totalProducts || 0 %>
                        </div>
                        <div class="text-xs text-info">
                            <i class="fas fa-arrow-up"></i> 3 new this week
                        </div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-boxes fa-2x text-success"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Quick Actions -->
<div class="row">
    <div class="col-12">
        <div class="card shadow mb-4">
            <div class="card-header py-3 d-flex justify-content-between align-items-center">
                <h6 class="m-0 font-weight-bold text-primary">
                    <i class="fas fa-bolt mr-2"></i>Quick Actions
                </h6>
                <span class="badge badge-primary badge-pill">4 Actions</span>
            </div>
            <div class="card-body">
                <div class="row quick-actions">
                    <div class="col-md-3 mb-3">
                        <a href="/admin/users" class="btn btn-primary btn-block h-100 d-flex flex-column align-items-center justify-content-center">
                            <i class="fas fa-users fa-2x mb-2"></i>
                            <span class="font-weight-bold">Manage Users</span>
                            <small class="text-light">Add, edit, delete users</small>
                        </a>
                    </div>
                    <div class="col-md-3 mb-3">
                        <a href="/admin/products" class="btn btn-success btn-block h-100 d-flex flex-column align-items-center justify-content-center">
                            <i class="fas fa-box fa-2x mb-2"></i>
                            <span class="font-weight-bold">Manage Products</span>
                            <small class="text-light">Add, edit, delete products</small>
                        </a>
                    </div>
                    <div class="col-md-3 mb-3">
                        <a href="/admin/categories" class="btn btn-info btn-block h-100 d-flex flex-column align-items-center justify-content-center">
                            <i class="fas fa-tags fa-2x mb-2"></i>
                            <span class="font-weight-bold">Categories</span>
                            <small class="text-light">Organize products</small>
                        </a>
                    </div>
                    <div class="col-md-3 mb-3">
                        <a href="/admin/orders" class="btn btn-warning btn-block h-100 d-flex flex-column align-items-center justify-content-center">
                            <i class="fas fa-shopping-cart fa-2x mb-2"></i>
                            <span class="font-weight-bold">View Orders</span>
                            <small class="text-light">Track sales & deliveries</small>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Recent Orders -->
<div class="row">
    <div class="col-12">
        <div class="card shadow mb-4">
            <div class="card-header py-3 d-flex justify-content-between align-items-center">
                <h6 class="m-0 font-weight-bold text-primary">
                    <i class="fas fa-clock mr-2"></i>Recent Orders
                </h6>
                <a href="/admin/orders" class="btn btn-sm btn-outline-primary">
                    View All Orders
                </a>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover" id="recent-orders-table">
                        <thead class="thead-light">
                            <tr>
                                <th>Order ID</th>
                                <th>Customer</th>
                                <th>Amount</th>
                                <th>Status</th>
                                <th>Date</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="recent-orders-body">
                            <!-- Orders will be loaded dynamically -->
                            <tr>
                                <td colspan="6" class="text-center text-muted">
                                    <i class="fas fa-spinner fa-spin mr-2"></i>Loading recent orders...
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Low Stock Alerts -->
<div class="row">
    <div class="col-12">
        <div class="card shadow mb-4 border-left-danger">
            <div class="card-header py-3 d-flex justify-content-between align-items-center bg-danger text-white">
                <h6 class="m-0 font-weight-bold">
                    <i class="fas fa-exclamation-triangle mr-2"></i>Low Stock Alerts
                </h6>
                <span class="badge badge-light badge-pill" id="low-stock-count">0</span>
            </div>
            <div class="card-body">
                <div id="low-stock-alerts">
                    <div class="text-center text-muted">
                        <i class="fas fa-spinner fa-spin mr-2"></i>Checking inventory levels...
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Discount Management -->
<div class="row">
    <div class="col-12">
        <div class="card shadow mb-4 border-left-success">
            <div class="card-header py-3 d-flex justify-content-between align-items-center bg-success text-white">
                <h6 class="m-0 font-weight-bold">
                    <i class="fas fa-percentage mr-2"></i>Discount Management
                </h6>
                <button class="btn btn-light btn-sm" data-bs-toggle="modal" data-bs-target="#addDiscountModal">
                    <i class="fas fa-plus mr-1"></i>Add Discount
                </button>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover" id="discounts-table">
                        <thead class="thead-light">
                            <tr>
                                <th>Product</th>
                                <th>Original Price</th>
                                <th>Discount %</th>
                                <th>Final Price</th>
                                <th>Start Date</th>
                                <th>End Date</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="discounts-body">
                            <tr>
                                <td colspan="8" class="text-center text-muted">
                                    <i class="fas fa-spinner fa-spin mr-2"></i>Loading discounts...
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add/Edit Discount Modal -->
<div class="modal fade" id="addDiscountModal" tabindex="-1" aria-labelledby="addDiscountModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addDiscountModalLabel">Add Product Discount</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="discountForm">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="discountProduct" class="form-label">Select Product</label>
                                <select class="form-select" id="discountProduct" required>
                                    <option value="">Choose a product...</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="discountPercentage" class="form-label">Discount Percentage</label>
                                <div class="input-group">
                                    <input type="number" class="form-control" id="discountPercentage" min="1" max="99" required>
                                    <span class="input-group-text">%</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="discountStartDate" class="form-label">Start Date</label>
                                <input type="datetime-local" class="form-control" id="discountStartDate" required>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="discountEndDate" class="form-label">End Date</label>
                                <input type="datetime-local" class="form-control" id="discountEndDate" required>
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="discountActive" checked>
                            <label class="form-check-label" for="discountActive">
                                Activate discount immediately
                            </label>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success" id="saveDiscount">
                    <i class="fas fa-save mr-1"></i>Save Discount
                </button>
            </div>
        </div>
    </div>
</div>